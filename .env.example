# --- neo4j (helyi) ---
NEO4J_URI=bolt://localhost:7687
# a NEO4J_USERNAME név is működik
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# --- LLM-kulcsok ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- szolgáltató és modell lépésenként ---
# A webes felület Modellek oldalán mentett beállítás (config/models.yaml) erősebb, mint ezek.
# GH_PROVIDER: anthropic | gemini | local | manual   (manual = a promptokat Claude Code-ban vagy chatben futtatod)
GH_PROVIDER=anthropic
# Alapértékek kitöltés nélkül: E0/P1 claude-sonnet-5-5 (effort low), P2/P3/P5 claude-haiku-5-5 (effort low),
# P4 claude-sonnet-5-5 (effort medium). Felülírás lépésenként:
# GH_MODEL_P1=claude-sonnet-5-5
# GH_EFFORT_P1=low            # low | medium | high | xhigh | max
# GH_THINKING_P3=off          # gondolkodás ki (Sonnet 5.5, Haiku 5.5, helyi Qwen)
# GH_MAX_TOKENS_P1=12000
# Gemini bírálóként: GH_PROVIDER_P2=gemini, GH_MODEL_P2=<a Gemini API modellneve>

# --- helyi modell: OpenAI-kompatibilis szerver (pl. vLLM a DGX Sparkon, Qwen) ---
# GH_LOCAL_BASE_URL=http://spark.local:8000/v1
# GH_LOCAL_MODEL=
# GH_LOCAL_API_KEY=
# GH_LOCAL_JSON_MODE=object   # object | schema | none
# GH_LOCAL_TIMEOUT=900
# GH_PROVIDER_P2=local
# GH_PROVIDER_P3=local
# GH_PROVIDER_P5=local
# GH_THINKING_P2=off
# GH_THINKING_P3=off
# GH_THINKING_P5=off

# --- bírálat (P2): auto = csak szabályjelzésnél + véletlen mintán | always | never ---
GH_P2_MODE=auto
GH_P2_SAMPLE=0.15

# --- hasonlóságkeresés ---
# Üresen: csak alias-egyezés + neo4j teljes szöveges index, a kétes eseteket a P3 dönti el.
# Helyi Ollama: GH_EMBED_PROVIDER=ollama, GH_EMBED_MODEL = az 'ollama list' szerinti név.
# Magyar + angol szöveghez többnyelvű modell kell, pl. bge-m3. Ellenőrzés: python -m gaphopper embed check
GH_EMBED_PROVIDER=ollama
GH_EMBED_MODEL=
OLLAMA_HOST=http://localhost:11434
# Egyes modellek feladat-előtagot várnak (pl. nomic-embed-text: "search_document: "); bge-m3-nál üres.
GH_EMBED_PREFIX=
GH_SIM_HI=0.92
GH_SIM_LO=0.70

# --- 0. lépés: dokumentumrészlet mérete (karakter) ---
GH_CHUNK_CHARS=24000
GH_CHUNK_OVERLAP=1500

# --- kötegelt futás: a hőmérsékletet csak GH_BATCH_TEMPERATURE=1 esetén küldjük ---
GH_BATCH_TEMPERATURE=0

# --- egyéb ---
GH_STATE_DB=runs/state.sqlite
# GH_LEMMATIZE=1

# --- külön OpenAI-kompatibilis API (GH_PROVIDER_<lépés>=openai) ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# A Modellek oldalon más kulcsváltozó neve és szolgáltatói URL is megadható.
