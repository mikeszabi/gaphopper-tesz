NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
SERVICE_AI_PROVIDER=anthropic
# Choose an available model ID; required unless each request supplies ai.
SERVICE_AI_MODEL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional machine-to-machine analysis API token (no admin permissions).
SERVICE_API_TOKEN=

# First service-state initialization only; existing users are managed on /config.html.
SERVICE_BOOTSTRAP_PASSWORD=gaphopper
# Default: 1 on Cloud Run, 0 locally. Use 1 when serving over HTTPS.
# SERVICE_COOKIE_SECURE=0
